{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bank.schema.json",
  "title": "SkillBank",
  "description": "One file per skill in content/bank. Passages, items and one worked example (model).",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "passages", "items", "model"],
  "properties": {
    "skill": { "$ref": "#/definitions/SkillId" },
    "passages": { "type": "array", "items": { "$ref": "#/definitions/Passage" } },
    "items": { "type": "array", "items": { "$ref": "#/definitions/Item" } },
    "model": { "$ref": "#/definitions/Model" }
  },
  "definitions": {
    "SkillId": {
      "type": "string",
      "enum": ["F1","F2","F3","F4","F5","F6","N1","N2","N3","N4","N5","N6","P1","P2","P3","P4","P5","P6"]
    },
    "Topic": {
      "type": "string",
      "enum": ["space","animals","transport","weather","maps","mining","games","sports","food","dinosaurs","robots","ocean","music","nature","school","home","friends","money","safety","health"]
    },
    "Credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "source", "licence", "retrieved", "adapted"],
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "licence": { "type": "string", "enum": ["original", "public-domain", "CC0", "CC-BY-4.0", "CC-BY-SA-4.0"] },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "adapted": { "type": "boolean" }
      }
    },
    "Sign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "color", "text"],
      "properties": {
        "shape": { "type": "string", "enum": ["octagon", "triangle", "rect", "circle", "diamond", "square"] },
        "color": { "type": "string", "enum": ["red", "yellow", "green", "blue", "white", "orange", "brown", "black"] },
        "text": { "type": "string" },
        "icon": { "type": "string", "description": "One emoji drawn on the sign" }
      }
    },
    "Visual": {
      "description": "A functional text drawn as a real-world object. Rows are what 'evidence' and highlight 'row' answers index into.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "signs"],
          "properties": { "type": { "const": "signs" }, "signs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Sign" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "columns", "rows"],
          "properties": {
            "type": { "const": "table" }, "title": { "type": "string" }, "note": { "type": "string" },
            "columns": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "ordered", "rows"],
          "properties": {
            "type": { "const": "list" }, "title": { "type": "string" }, "note": { "type": "string" },
            "ordered": { "type": "boolean" }, "rows": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "title", "rows"],
          "properties": {
            "type": { "const": "label" }, "title": { "type": "string" }, "warning": { "type": "string" },
            "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": { "k": { "type": "string" }, "v": { "type": "string" } } } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "app", "from", "rows"],
          "properties": {
            "type": { "const": "message" }, "app": { "type": "string", "enum": ["text", "email", "note", "chat"] },
            "from": { "type": "string" }, "to": { "type": "string" }, "subject": { "type": "string" }, "time": { "type": "string" },
            "rows": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "title", "rows", "buttons"],
          "properties": {
            "type": { "const": "prompt" }, "title": { "type": "string" }, "icon": { "type": "string" },
            "rows": { "type": "array", "items": { "type": "string" } },
            "buttons": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "title", "rows"],
          "properties": {
            "type": { "const": "form" }, "title": { "type": "string" },
            "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["k"], "properties": { "k": { "type": "string" }, "v": { "type": "string" } } } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "title", "rows"],
          "properties": {
            "type": { "const": "notice" }, "title": { "type": "string" }, "icon": { "type": "string" },
            "rows": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "Passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "sentences", "topics", "level", "socialLoad", "credit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "kind": { "type": "string", "enum": ["story", "fable", "article", "sign", "directions", "list", "menu", "timetable", "schedule", "label", "receipt", "ticket", "message", "notice", "form", "prompt", "recipe", "poem"] },
        "sentences": { "type": "array", "items": { "type": "string" }, "description": "Prose, one sentence per entry. May be empty when the visual carries the text." },
        "visual": { "$ref": "#/definitions/Visual" },
        "picture": { "type": "string", "description": "One to three emoji shown as picture support" },
        "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Topic" } },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "socialLoad": { "type": "integer", "minimum": 0, "maximum": 2, "description": "0 none, 1 some feelings or intentions, 2 depends on reading people" },
        "themes": { "type": "array", "items": { "type": "string", "enum": ["loss", "illness", "suffering", "fear"] }, "description": "Hard themes. Hidden unless an adult turns them on." },
        "credit": { "$ref": "#/definitions/Credit" },
        "reviewed": { "type": "boolean" }
      }
    },
    "SceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "emoji": { "type": "string" },
        "sign": { "$ref": "#/definitions/Sign" }
      }
    },
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "options"],
      "properties": {
        "kind": { "type": "string", "enum": ["who", "where", "when", "problem", "feeling", "want", "plan", "ending", "first", "then", "last", "why", "main", "lesson", "evidence", "me", "other"] },
        "label": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
        "answer": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Accepted option indexes. Omit for express-tier slots where any choice is fine." },
        "rubric": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Express tier only: which rubric point this slot shows" },
        "optional": { "type": "boolean" }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "passage", "format", "level", "prompt", "explain"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "skill": { "$ref": "#/definitions/SkillId" },
        "passage": { "type": "string" },
        "format": { "type": "string", "enum": ["tap", "order", "storymap", "highlight", "sort", "scene", "build"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "prompt": { "type": "string" },
        "focus": { "type": "string", "description": "A word in the passage to mark as a cue, for example a pronoun" },
        "evidence": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Sentence indexes, or visual row indexes, that hold the answer. Used by the first hint." },
        "hint": { "type": "string", "description": "A strategy, not the answer" },
        "explain": { "type": "string", "description": "Says the answer and where it is in the text" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "transfer": { "type": "boolean", "description": "A new format or a new kind of text for this skill" },
        "inference": { "type": "integer", "minimum": 0, "maximum": 2 },
        "placement": { "type": "boolean" },
        "gatecheck": { "type": "boolean", "description": "Reserved for the inference check. Never used in normal sessions." },
        "tier": { "type": "string", "enum": ["understand", "express"] },
        "personal": { "type": "boolean", "description": "About the learner's own life. The answer goes to the adult." },

        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" }, "description": "tap" },
        "pictures": { "type": "array", "items": { "type": "string" }, "description": "tap: one emoji per option" },
        "answer": {
          "description": "tap and scene: option index. scene may use an array to mean tap these in order. highlight: accepted sentence or row indexes.",
          "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } } ]
        },
        "scene": { "type": "string", "enum": ["hall", "street", "kitchen", "phone", "shop", "station", "park", "school", "home"] },
        "objects": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/definitions/SceneObject" } },
        "steps": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string" }, "description": "order: in the correct order" },
        "slots": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/definitions/Slot" } },
        "frame": { "type": "string", "description": "build: sentence with {0}, {1} placeholders for slots" },
        "unit": { "type": "string", "enum": ["sentence", "word", "row"], "description": "highlight" },
        "accept": { "type": "array", "items": { "type": "string" }, "description": "highlight with unit word: accepted words" },
        "bins": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string" } },
        "cards": {
          "type": "array", "minItems": 3, "maxItems": 8,
          "items": { "type": "object", "additionalProperties": false, "required": ["text", "bin"], "properties": { "text": { "type": "string" }, "bin": { "type": "integer", "minimum": 0 }, "emoji": { "type": "string" } } }
        }
      }
    },
    "Model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "steps"],
      "description": "The guide's worked example. The item it uses is never served as practice.",
      "properties": {
        "item": { "type": "string" },
        "steps": {
          "type": "array", "minItems": 3, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["say"],
            "properties": {
              "say": { "type": "string" },
              "show": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Sentence or row indexes to highlight" },
              "reveal": { "type": "boolean", "description": "Show the answer at this step" }
            }
          }
        }
      }
    }
  }
}
