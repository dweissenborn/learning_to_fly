{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.schema.json",
  "title": "LogEvent",
  "description": "One entry in the append-only progress log. Every view of progress is derived from these.",
  "oneOf": [
    {
      "$ref": "#/definitions/AnswerEvent"
    },
    {
      "$ref": "#/definitions/SessionEvent"
    },
    {
      "$ref": "#/definitions/PlacementEvent"
    },
    {
      "$ref": "#/definitions/WorldEvent"
    },
    {
      "$ref": "#/definitions/RecountEvent"
    },
    {
      "$ref": "#/definitions/RealWorldEvent"
    },
    {
      "$ref": "#/definitions/ActivityEvent"
    }
  ],
  "definitions": {
    "Phase": {
      "type": "string",
      "enum": [
        "warmup",
        "together",
        "yourturn",
        "placement",
        "gatecheck"
      ]
    },
    "Strand": {
      "type": "string",
      "enum": [
        "functional",
        "narrative",
        "philosophical"
      ]
    },
    "AnswerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "session",
        "item",
        "skill",
        "phase",
        "correct",
        "hint",
        "tries",
        "ms",
        "format"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "type": {
          "const": "answer"
        },
        "session": {
          "type": "string"
        },
        "item": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "correct": {
          "type": "boolean",
          "description": "Right on the first try with no hint"
        },
        "hint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Highest hint level shown"
        },
        "tries": {
          "type": "integer",
          "minimum": 1
        },
        "ms": {
          "type": "number"
        },
        "format": {
          "type": "string"
        },
        "transfer": {
          "type": "boolean"
        },
        "interest": {
          "type": "boolean",
          "description": "The passage matched one of the learner's interests"
        },
        "readAloud": {
          "type": "boolean"
        },
        "rubric": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Express-tier items: rubric points shown"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "The item's text level, so the level staircase has a record"
        },
        "delay": {
          "type": "integer",
          "minimum": 0,
          "description": "Guided practice: seconds the clue waited before showing (0 = shown at once on a new skill's first item, LTF-01)."
        }
      }
    },
    "SessionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "session",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "type": {
          "const": "session"
        },
        "session": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "finish",
            "stop"
          ]
        },
        "strand": {
          "$ref": "#/definitions/Strand"
        },
        "skill": {
          "type": "string"
        },
        "gatecheck": {
          "type": "boolean"
        }
      }
    },
    "PlacementEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "functional",
        "narrative",
        "word",
        "reading",
        "listening"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "type": {
          "const": "placement"
        },
        "functional": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "Starting step; steps below it start as mastered and enter review"
        },
        "narrative": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "word": {
          "type": "number",
          "description": "Share correct, 0 to 1"
        },
        "reading": {
          "type": "number"
        },
        "listening": {
          "type": "number"
        },
        "manual": {
          "type": "boolean",
          "description": "Set by an adult rather than by the checks"
        }
      }
    },
    "WorldEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "piece",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "type": {
          "const": "world"
        },
        "piece": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "RecountEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "stage",
        "parts"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "type": {
          "const": "recount"
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "parts": {
          "type": "integer",
          "minimum": 1,
          "description": "How many parts of the day were told. The words live in the notes store, which has a retention limit."
        },
        "typed": {
          "type": "boolean"
        },
        "topic": {
          "type": "string",
          "enum": [
            "day",
            "show"
          ],
          "description": "Telling about his day, or about a show or video he watched"
        },
        "sentences": {
          "type": "integer",
          "minimum": 0,
          "description": "How many sentences the built recount had (LTF-08)."
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The questions he skipped (LTF-08)."
        },
        "after": {
          "type": "boolean",
          "description": "He answered a \"What happened after that?\" question (LTF-05)."
        }
      }
    },
    "RealWorldEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "skill"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "type": {
          "const": "realworld"
        },
        "skill": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ActivityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "type",
        "session",
        "kind"
      ],
      "description": "How a session went, moment to moment: steps entered, idle spells, leaving the app, demo skips, his votes on new things, and the bonus for getting past his usual stopping point. Holds no text he wrote.",
      "properties": {
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "type": {
          "const": "activity"
        },
        "session": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "step",
            "idle",
            "away",
            "back",
            "skip-demo",
            "boost",
            "opinion"
          ],
          "description": "step: entered a step. idle: no touch or key for a while. away: the app was hidden. back: returned from idle or away. skip-demo: pressed 'Got it, skip'. boost: got past his usual stopping point. opinion: his answer on a 'What do you think?' card."
        },
        "step": {
          "type": "string",
          "enum": [
            "plan",
            "choose",
            "warmup",
            "watch",
            "together",
            "yourturn",
            "gatecheck",
            "finish"
          ]
        },
        "item": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "enum": [
            "idle",
            "away"
          ],
          "description": "For back: what he returned from."
        },
        "ms": {
          "type": "number",
          "minimum": 0,
          "description": "For back: how long the idle spell or absence lasted. For idle: time since the last touch."
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "description": "For boost: flight points earned."
        },
        "feature": {
          "type": "string",
          "description": "For opinion: which new thing he was asked about."
        },
        "like": {
          "type": "string",
          "enum": [
            "like",
            "unsure",
            "dislike"
          ],
          "description": "For opinion: I like it, not sure, or I don't like it."
        },
        "amount": {
          "type": "string",
          "enum": [
            "too-much",
            "just-right",
            "too-little"
          ],
          "description": "For opinion: too much, just right, or too little."
        }
      }
    }
  }
}